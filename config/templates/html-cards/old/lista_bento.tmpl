<!-- Apenas um espaçador para o botão de salvar absoluto -->
<div style="height: 12px;"></div>

<div class="entrada_div">
    <div class="dict-entry lista-linear-view" style="padding-left: 36px; padding-top: 4px; padding-right: 64px;">

        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
            <h1 class="dict-headword" style="margin: 0; color: #15803d; font-weight: bold;">{{ TERMO }}</h1>
            {{#AUDIOS_ARRAY}}
            <button class="modal-audio-btn" style="display: inline-flex; width: 32px; height: 32px; justify-content: center; align-items: center; font-size: 1.2rem; margin-left: 8px;" title="Ouvir pronúncia" aria-label="Ouvir pronúncia" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)" data-texto-original="🔊">🔊</button>
            {{/AUDIOS_ARRAY}}
        </div>

        <div class="dict-variations-tray" style="margin-bottom: 12px;">
            {{#TEM_INFO_GERAL}}{{#CLASSE}}<span class="dict-audio-chip" style="background:transparent; border:none; padding:0;"><em>{{ CLASSE }}</em></span>{{/CLASSE}}{{/TEM_INFO_GERAL}}
            
            {{#AUDIOS_ADICIONAIS}}
            <button class="modal-audio-btn" style="display: inline-flex; width: 28px; height: 28px; justify-content: center; align-items: center; font-size: 1rem;" title="Ouvir variação" aria-label="Ouvir variação" onclick="event.stopPropagation(); tocarAudio('{{ URL }}', this)" data-texto-original="🔊">🔊</button>
            {{/AUDIOS_ADICIONAIS}}

            {{#TEM_PRONUNCIA}}
            {{#FONEMICA}}<span class="dict-audio-chip" style="pointer-events: none; background: transparent; border: none;"><span class="dict-chip-ipa">{{ FONEMICA }}</span></span>{{/FONEMICA}}
            {{#FONETICA}}<span class="dict-audio-chip" style="pointer-events: none; background: transparent; border: none;"><span class="dict-chip-ipa">{{ FONETICA }}</span></span>{{/FONETICA}}
            {{/TEM_PRONUNCIA}}
        </div>

        {{#SIGNIFICADOS}}
        <div class="dict-sense-card" style="padding: 12px 0; border: none; box-shadow: none; border-bottom: 1px dashed #e2e8f0; border-radius: 0;">
            <div class="dict-sense-header" style="margin-bottom: 8px;">
                <span class="dict-sense-number" style="font-size: 1.1rem;">{{ NUMERO_PONTO }}</span>
                {{#TRADUCAO}}<span class="dict-sense-translation" style="font-size: 1.1rem;">{{ TRADUCAO }}</span>{{/TRADUCAO}}
                {{#DESCRICAO}}<span class="dict-sense-definition" style="font-size: 0.95rem;">{{ DESCRICAO }}</span>{{/DESCRICAO}}
            </div>

            {{#TEM_EXEMPLOS}}
            <ul class="dict-examples-list" style="margin: 8px 0; border-top: none;">
                {{#EXEMPLOS}}
                <li class="dict-example-item" style="padding: 8px 0; border-bottom: none;">
                    <div class="dict-ex-source" style="font-size: 0.95rem;">
                        <span style="color: #15803d; font-weight: bold;">{{ TRANS }}</span>
                        {{#AUDIOS_ARRAY}}
                        <button class="modal-audio-btn" style="display: inline-flex; width: 24px; height: 24px; justify-content: center; align-items: center; font-size: 0.8rem; margin-left: 4px;" title="Ouvir pronúncia" aria-label="Ouvir pronúncia" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)" data-texto-original="🔊">🔊</button>
                        {{/AUDIOS_ARRAY}}
                    </div>
                    <div class="dict-ex-target" style="font-size: 0.85rem;">{{ TRAD }}</div>
                </li>
                {{/EXEMPLOS}}
            </ul>
            {{/TEM_EXEMPLOS}}

            <!-- Mídias Empilhadas Verticulamente (Sem Carrossel e Sem Esticar) -->
            {{#TEM_IMAGENS}}
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                {{#IMAGENS}}
                <figure onclick="event.stopPropagation(); abrirLightbox('{{ ARQUIVO }}')" style="margin: 0; cursor: pointer; max-width: 100%; display: inline-block; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
                    <img src="{{ ARQUIVO }}" alt="{{ LEGENDA }}" loading="lazy" style="display: block; max-width: 100%; height: auto; max-height: 250px; object-fit: contain; margin: 0 auto;">
                    {{#LEGENDA}}<figcaption style="padding: 6px; font-size: 0.8rem; text-align: center; color: #475569; background: #fff;">{{ LEGENDA }}</figcaption>{{/LEGENDA}}
                </figure>
                {{/IMAGENS}}
            </div>
            {{/TEM_IMAGENS}}

            {{#TEM_VIDEOS}}
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 8px;">
                {{#VIDEOS}}
                <figure style="margin: 0; max-width: 100%; display: inline-block; border-radius: 8px; overflow: hidden;">
                    <video controls loading="lazy" onclick="event.stopPropagation()" style="display: block; max-width: 100%; max-height: 250px;">
                        <source src="{{ ARQUIVO }}" type="video/mp4">
                    </video>
                </figure>
                {{/VIDEOS}}
            </div>
            {{/TEM_VIDEOS}}

            {{#TEM_EXTRAS}}
            <div style="margin-top: 8px;">
                {{#EXTRAS}}
                <div style="background: #fef9c3; color: #854d0e; padding: 8px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 4px;">{{ TEXTO }}</div>
                {{/EXTRAS}}
            </div>
            {{/TEM_EXTRAS}}
        </div>
        {{/SIGNIFICADOS}}

        {{#ITENS_RELACIONADOS}}
        <footer style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #e2e8f0; font-size: 0.9rem;">
            <span style="font-weight: 600; color: #64748b; margin-right: 8px;">Veja também:</span>
            <span style="color: var(--cor-primaria); font-weight: 500;">{{ ITENS_RELACIONADOS }}</span>
        </footer>
        {{/ITENS_RELACIONADOS}}

        {{#TEXTOS_ESTRUTURADOS}}
        <div class="dict-text-card" id="texto_{{ ID_TEXTO }}" style="margin-top: 12px; padding: 12px;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                <strong style="font-size: 1rem;">📄 {{ TITULO_EXIBICAO_FALLBACK }}</strong>
                <button class="modal-audio-btn" style="display: inline-flex; width: 28px; height: 28px; justify-content: center; align-items: center; font-size: 1rem;" onclick="event.stopPropagation(); tocaTexto(this, 'texto_{{ ID_TEXTO }}')" title="Tocar texto" data-texto-original="🔊">🔊</button>
            </div>
            {{#TEXTO_NAO_LITERAL}}<div style="font-style: italic; font-size: 0.9rem; color: #64748b; margin-bottom: 8px;">{{ TEXTO_NAO_LITERAL }}</div>{{/TEXTO_NAO_LITERAL}}

            {{#VARIACOES}}
            <div>
                {{#FRASES}}
                <div class="dict-text-phrase" style="padding: 8px; margin-bottom: 4px; display: flex; flex-direction: column; gap: 4px;" onclick="event.stopPropagation(); playAudio_frase(this)">
                    {{#AUDIO_ARQUIVO}}<audio src="{{ AUDIO_ARQUIVO }}" preload="none" style="display: none;"></audio>{{/AUDIO_ARQUIVO}}
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="color: #15803d; font-weight: bold; font-size: 0.95rem;">{{ ORIGINAL }}</span>
                        {{#AUDIO_ARQUIVO}}
                        <button class="modal-audio-btn" style="display: inline-flex; width: 24px; height: 24px; justify-content: center; align-items: center; font-size: 0.8rem;" title="Ouvir frase" aria-label="Ouvir frase" data-texto-original="🔊">🔊</button>
                        {{/AUDIO_ARQUIVO}}
                    </div>
                    {{#TRADUCAO}}<div style="font-size: 0.85rem; color: #64748b;">{{ TRADUCAO }}</div>{{/TRADUCAO}}
                </div>
                {{/FRASES}}
            </div>
            {{/VARIACOES}}
        </div>
        {{/TEXTOS_ESTRUTURADOS}}
    </div>
</div>
