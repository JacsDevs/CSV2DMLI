<div class="entrada_div">
    <div class="dict-entry lista-linear-view" style="padding-right: 52px;">
        <header class="dict-header">
            <div class="dict-headword-container">
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    {{#TEM_TERMOS_MISTOS}}
                    {{#TERMOS_MISTOS}}
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <h2 class="dict-headword">{{ TERMO_PARTE }}</h2>
                        {{#TEM_AUDIO}}
                        <button type="button" class="btn-audio" title="Ouvir pronúncia" aria-label="Ouvir pronúncia de {{ TERMO_PARTE }}" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)">
                            <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
                        </button>
                        {{/TEM_AUDIO}}
                    </div>
                    {{#NAO_E_O_ULTIMO}}<span class="dict-headword" style="opacity: 0.5;">~</span>{{/NAO_E_O_ULTIMO}}
                    {{/TERMOS_MISTOS}}
                    {{/TEM_TERMOS_MISTOS}}

                    {{#NAO_TEM_TERMOS_MISTOS}}
                    <h2 class="dict-headword">{{ TERMO }}</h2>
                    {{#AUDIOS_ARRAY}}
                    <button type="button" class="btn-audio" title="Ouvir pronúncia" aria-label="Ouvir pronúncia de {{ TERMO }}" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)">
                        <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
                    </button>
                    {{/AUDIOS_ARRAY}}
                    {{/NAO_TEM_TERMOS_MISTOS}}
                </div>

                {{#TEM_VARIACOES_TRAY}}
                <div class="dict-variations-tray">
                    {{#TEM_INFO_GERAL}}
                        {{#CLASSE}}<span class="tag classe-gramatical">{{ CLASSE }}</span>{{/CLASSE}}
                    {{/TEM_INFO_GERAL}}

                    {{#AUDIOS_ADICIONAIS}}
                    <button type="button" class="btn-audio btn-audio-sm" title="Ouvir variação" aria-label="Ouvir variação" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)">
                        <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
                    </button>
                    {{/AUDIOS_ADICIONAIS}}

                    {{#TEM_PRONUNCIA}}
                    {{#FONEMICA}}<span class="dict-audio-chip transcricao-fonetica"><span class="dict-chip-ipa">{{ FONEMICA }}</span></span>{{/FONEMICA}}
                    {{#FONETICA}}<span class="dict-audio-chip transcricao-fonetica"><span class="dict-chip-ipa">{{ FONETICA }}</span></span>{{/FONETICA}}
                    {{/TEM_PRONUNCIA}}
                </div>
                {{/TEM_VARIACOES_TRAY}}
            </div>
        </header>

        {{#SIGNIFICADOS}}
        <article class="dict-sense-card">
            <div class="dict-sense-header">
                <span class="dict-sense-number">{{ NUMERO_PONTO }}</span>
                {{#TRADUCAO}}<span class="dict-sense-translation">{{ TRADUCAO }}</span>{{/TRADUCAO}}

                {{#TEM_AUDIO_REVERSO}}
                <button type="button" class="btn-audio btn-audio-sm" title="Ouvir pronúncia" aria-label="Ouvir pronúncia" onclick="event.stopPropagation(); window.tocarAudio('{{ AUDIO_REVERSO_URL }}', this)">
                    <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
                </button>
                {{/TEM_AUDIO_REVERSO}}

                {{#CLASSE_REVERSO}}<span class="tag classe-gramatical">{{ CLASSE_REVERSO }}</span>{{/CLASSE_REVERSO}}
                {{#FONEMICA_REVERSO}}<span class="dict-audio-chip transcricao-fonetica"><span class="dict-chip-ipa">{{ FONEMICA_REVERSO }}</span></span>{{/FONEMICA_REVERSO}}
                {{#FONETICA_REVERSO}}<span class="dict-audio-chip transcricao-fonetica"><span class="dict-chip-ipa">{{ FONETICA_REVERSO }}</span></span>{{/FONETICA_REVERSO}}

                {{#DESCRICAO}}<span class="dict-sense-definition">{{ DESCRICAO }}</span>{{/DESCRICAO}}
            </div>

            {{#TEM_EXEMPLOS}}
            <ul class="dict-examples-list">
                {{#EXEMPLOS}}
                <li class="dict-example-item">
                    <div class="dict-ex-source">
                        <span>{{ TRANS }}</span>
                        {{#AUDIOS_ARRAY}}
                        <button type="button" class="btn-audio btn-audio-sm" title="Ouvir exemplo" aria-label="Ouvir exemplo" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)">
                            <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
                        </button>
                        {{/AUDIOS_ARRAY}}
                    </div>
                    <div class="dict-ex-target">{{ TRAD }}</div>
                </li>
                {{/EXEMPLOS}}
            </ul>
            {{/TEM_EXEMPLOS}}

            {{#TEM_IMAGENS}}
            <div class="dict-media-carousel">
                {{#IMAGENS}}
                <figure class="dict-media-card" onclick="event.stopPropagation(); abrirLightbox('{{ ARQUIVO }}')">
                    <img src="{{ ARQUIVO }}" alt="{{ LEGENDA }}" loading="lazy">
                    {{#LEGENDA}}<figcaption>{{ LEGENDA }}</figcaption>{{/LEGENDA}}
                </figure>
                {{/IMAGENS}}
            </div>
            {{/TEM_IMAGENS}}

            {{#TEM_VIDEOS}}
            <div class="dict-media-carousel">
                {{#VIDEOS}}
                <figure class="dict-media-card">
                    <video controls loading="lazy" onclick="event.stopPropagation()">
                        <source src="{{ ARQUIVO }}" type="video/mp4">
                    </video>
                </figure>
                {{/VIDEOS}}
            </div>
            {{/TEM_VIDEOS}}

            {{#TEM_EXTRAS}}
            <div style="margin-top: 14px;">
                {{#EXTRAS}}
                <div class="dict-extra">{{ TEXTO }}</div>
                {{/EXTRAS}}
            </div>
            {{/TEM_EXTRAS}}

            {{#TEXTOS_ESTRUTURADOS}}
            <div class="dict-text-card" id="texto_{{ ID_TEXTO }}" style="margin-top: 14px;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                    <strong style="font-size: 1.02rem;">{{ TITULO_EXIBICAO_FALLBACK }}</strong>
                    <button type="button" class="btn-audio btn-audio-sm toca-texto-btn" onclick="event.stopPropagation(); tocaTexto(this, 'texto_{{ ID_TEXTO }}')" title="Tocar texto" aria-label="Tocar texto">
                        <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
                    </button>
                </div>
                {{#TEXTO_NAO_LITERAL}}<div class="dict-sense-definition" style="font-style: italic; margin-bottom: 14px;">{{ TEXTO_NAO_LITERAL }}</div>{{/TEXTO_NAO_LITERAL}}

                {{#VARIACOES}}
                <div>
                    {{#FRASES}}
                    <div class="dict-text-phrase frase-item" onclick="event.stopPropagation(); playAudio_frase(this)">
                        {{#AUDIO_ARQUIVO}}<audio src="{{ AUDIO_ARQUIVO }}" preload="none" style="display: none;"></audio>{{/AUDIO_ARQUIVO}}
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="texto-frase" style="font-weight: 600; color: var(--cor-primaria);">{{ ORIGINAL }}</span>
                            {{#AUDIO_ARQUIVO}}
                            <button type="button" class="btn-audio btn-audio-sm" title="Ouvir frase" aria-label="Ouvir frase">
                                <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
                            </button>
                            {{/AUDIO_ARQUIVO}}
                        </div>
                        {{#TRADUCAO}}<div class="dict-ex-target" style="font-size: 0.9rem;">{{ TRADUCAO }}</div>{{/TRADUCAO}}
                    </div>
                    {{/FRASES}}
                </div>
                {{/VARIACOES}}
            </div>
            {{/TEXTOS_ESTRUTURADOS}}
        </article>
        {{/SIGNIFICADOS}}

        {{#ITENS_RELACIONADOS}}
        <footer class="dict-veja-tambem">
            <span style="font-weight: 700; margin-right: 6px;">Veja também:</span>
            <span style="color: var(--cor-primaria); font-weight: 600;">{{ ITENS_RELACIONADOS }}</span>
        </footer>
        {{/ITENS_RELACIONADOS}}
    </div>
</div>
