<span style="display: block; padding-right: 64px;">
    <span class='palavra_entrada'>{{ TERMO }}</span>
    {{#AUDIOS_ARRAY}}
    <button type="button" class="modal-audio-btn" style="width: 32px; height: 32px; font-size: 0.9rem; margin-left: 8px; vertical-align: middle; display: inline-flex; flex-shrink: 0;" title="Ouvir pronúncia" aria-label="Ouvir pronúncia" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)">🔊</button>
    {{/AUDIOS_ARRAY}}
</span>
<div class="entrada_div">
    <div class="info_entrada">
        {{#TEM_INFO_GERAL}}
        <div class="detalhe-secao">
            <div class="detalhe-titulo">Informações</div>
            {{#INDEX}}<div class="detalhe-valor mb-2"><strong>Tradução/Significado:</strong> {{ INDEX }}</div>{{/INDEX}}
            {{#CLASSE}}<div class="detalhe-valor mb-2"><strong>Classe Gramatical:</strong> {{ CLASSE }}</div>{{/CLASSE}}
            {{#CAMPO_SEMANTICO}}<div class="detalhe-valor mb-2"><strong>Campo Semântico:</strong> {{ CAMPO_SEMANTICO }}</div>{{/CAMPO_SEMANTICO}}
            {{#SUB_CAMPO_SEMANTICO}}<div class="detalhe-valor mb-2"><strong>Subcampo:</strong> {{ SUB_CAMPO_SEMANTICO }}</div>{{/SUB_CAMPO_SEMANTICO}}
        </div>
        {{/TEM_INFO_GERAL}}

        {{#TEM_PRONUNCIA}}
        <div class="detalhe-secao">
            <div class="detalhe-titulo">Pronúncia</div>
            {{#FONEMICA}}<div class="detalhe-valor mb-2"><strong>Fonêmica:</strong> {{ FONEMICA }}</div>{{/FONEMICA}}
            {{#FONETICA}}<div class="detalhe-valor"><strong>Fonética:</strong> {{ FONETICA }}</div>{{/FONETICA}}
        </div>
        {{/TEM_PRONUNCIA}}

        {{#SIGNIFICADOS}}
        <div class="significado-item">
            {{#TRADUCAO}}<strong>{{ NUMERO_PONTO }} {{ TRADUCAO }}</strong><br>{{/TRADUCAO}}
            {{#DESCRICAO}}<span class="texto-muted">{{ DESCRICAO }}</span><br>{{/DESCRICAO}}
            
            {{#TEM_EXEMPLOS}}
            <div style="margin-left: 16px; margin-top: 6px;">
                {{#EXEMPLOS}}
                <div style="margin-bottom: 4px;">
                    <em>{{ TRANS }}</em> - {{ TRAD }}
                    {{#AUDIOS_ARRAY}}
                    <button type="button" class="modal-audio-btn" style="width: 24px; height: 24px; font-size: 0.7rem; margin-left: 8px; vertical-align: middle; display: inline-flex;" title="Ouvir pronúncia" aria-label="Ouvir pronúncia" onclick="event.stopPropagation(); window.tocarAudio('{{ URL }}', this)">🔊</button>
                    {{/AUDIOS_ARRAY}}
                </div>
                {{/EXEMPLOS}}
            </div>
            {{/TEM_EXEMPLOS}}

            {{#TEM_IMAGENS}}
            <div class="midia-galeria" style="margin-left: 16px; margin-top: 8px;">
                {{#IMAGENS}}
                <figure class="midia-item" onclick="abrirLightbox('{{ ARQUIVO }}')" style="display: inline-block; margin-right: 8px; margin-bottom: 8px;">
                    <img src="{{ ARQUIVO }}" alt="{{ LEGENDA }}" loading="lazy" style="max-height: 100px; border-radius: 4px; cursor: pointer;">
                    {{#LEGENDA}}<figcaption style="font-size: 0.8rem; text-align: center;">{{ LEGENDA }}</figcaption>{{/LEGENDA}}
                </figure>
                {{/IMAGENS}}
            </div>
            {{/TEM_IMAGENS}}

            {{#TEM_VIDEOS}}
            <div class="midia-galeria" style="margin-left: 16px; margin-top: 8px;">
                {{#VIDEOS}}
                <figure class="midia-item" style="border: none; padding: 0; display: inline-block; margin-right: 8px; margin-bottom: 8px;">
                    <video controls style="max-height: 150px; border-radius: 4px;" loading="lazy">
                        <source src="{{ ARQUIVO }}" type="video/mp4">
                    </video>
                </figure>
                {{/VIDEOS}}
            </div>
            {{/TEM_VIDEOS}}

            {{#TEM_EXTRAS}}
            <div style="margin-left: 16px; margin-top: 8px;">
                {{#EXTRAS}}
                <div class="detalhe-valor" style="background:#f8f9fa; padding:8px; border-left:3px solid var(--cor-primaria); margin-top:4px; font-size: 0.9rem;">{{ TEXTO }}</div>
                {{/EXTRAS}}
            </div>
            {{/TEM_EXTRAS}}
        </div>
        {{/SIGNIFICADOS}}
    </div>
</div>

{{#ITENS_RELACIONADOS}}
<div class="detalhe-secao" style="margin-top: 12px; margin-left: 12px; border-top: 1px dashed #ddd; padding-top: 8px;">
    <div class="detalhe-titulo">🔗 Itens Relacionados</div>
    <div class="detalhe-valor" style="font-size: 0.9rem;">{{ ITENS_RELACIONADOS }}</div>
</div>
{{/ITENS_RELACIONADOS}}

{{#TEXTOS_ESTRUTURADOS}}
<div class="detalhe-secao texto-estruturado" id="texto_{{ ID_TEXTO }}" style="margin-top: 16px; margin-left: 12px; border-top: 1px dashed #ddd; padding-top: 8px;">
    <div class="detalhe-titulo" style="display: flex; align-items: center; gap: 8px; font-size: 1rem;">
        📄 {{ TITULO_EXIBICAO_FALLBACK }}
        <button class="modal-audio-btn" style="width: 24px; height: 24px; font-size: 0.7rem;" onclick="event.stopPropagation(); tocaTexto(this, 'texto_{{ ID_TEXTO }}')" title="Tocar texto completo">🔊</button>
    </div>
    {{#TEXTO_NAO_LITERAL}}<div class="detalhe-valor mb-3" style="font-style: italic; color: #555; background: #f8f9fa; padding: 8px; border-radius: 4px; font-size: 0.9rem;">{{ TEXTO_NAO_LITERAL }}</div>{{/TEXTO_NAO_LITERAL}}

    {{#VARIACOES}}
    <div class="texto-variacao mb-2">
        {{#FRASES}}
        <div class="frase-item" onclick="event.stopPropagation(); playAudio_frase(this)" style="cursor: pointer; padding: 8px; border-radius: var(--raio); transition: background-color 0.2s; margin-bottom: 4px; border: 1px solid #eee;">
            {{#AUDIO_ARQUIVO}}
            <audio src="{{ AUDIO_ARQUIVO }}" preload="none" style="display: none;"></audio>
            {{/AUDIO_ARQUIVO}}
            <div class="texto-frase" style="margin-bottom: 2px; font-weight: 500; font-size: 0.95rem; color: var(--cor-texto);">{{ ORIGINAL }}</div>
            {{#TRADUCAO}}
            <div class="texto-traducao" style="color: #666; font-size: 0.85rem;">{{ TRADUCAO }}</div>
            {{/TRADUCAO}}
        </div>
        {{/FRASES}}
    </div>
    {{/VARIACOES}}
</div>
{{/TEXTOS_ESTRUTURADOS}}
