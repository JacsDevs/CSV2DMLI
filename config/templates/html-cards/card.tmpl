<div class="card-texto">
    {{#CAMPO_SEMANTICO_EXIBIR}}
    <div class="card-categoria">{{ CAMPO_SEMANTICO }}</div>
    {{/CAMPO_SEMANTICO_EXIBIR}}
    <div class="card-termo-linha">
        <span class="card-termo">{{ TERMO }}</span>
        {{#AUDIO}}
        <button type="button" class="btn-audio btn-audio-sm" title="Ouvir pronúncia" aria-label="Ouvir pronúncia de {{ TERMO }}" onclick="event.stopPropagation(); window.tocarAudio('{{ AUDIO_PRIMEIRO }}', this)">
            <svg class="icone" aria-hidden="true"><use href="#ic-som"></use></svg>
        </button>
        {{/AUDIO}}
    </div>
    <div class="card-traducao">{{ INDEX }}</div>
    {{#CLASSE}}<div class="card-rodape"><span class="tag">{{ CLASSE }}</span></div>{{/CLASSE}}
</div>
{{#PRIMEIRA_IMAGEM}}
<div class="card-media"><img src="{{ PRIMEIRA_IMAGEM }}" alt="Imagem ilustrativa de {{ TERMO }}" loading="lazy"></div>
{{/PRIMEIRA_IMAGEM}}
